# Copy to .env. Real environment variables take precedence; restart after edits.
# Default: local Ollama (no API key required).
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=

# For a cloud API, REPLACE the four values above:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=your-model-id
# LLM_API_KEY=your-api-key
# The client appends /chat/completions. Keep any required /v1 prefix.

LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=1.0
# Leave temperature empty to omit it for models that do not support it.
# Set max_completion_tokens if required by your model/provider.
LLM_TOKEN_LIMIT_FIELD=max_tokens

# Same-origin webpage needs no CORS. List explicit origins if required.
# For the old file:// opening method, explicitly set CORS_ALLOW_ORIGINS=null.
CORS_ALLOW_ORIGINS=
